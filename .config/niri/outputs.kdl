output "eDP-1" {
    // off

    scale 1.0
    // transform "90"
    position x=0 y=0
    mode "1920x1080"
}

output "Dell Inc. DELL S2725DC HWWVPB4" {
    // off

    focus-at-startup
    scale 1.0
    position x=1920 y=-400
    mode "2560x1440@143.973"
}

output "Philips Consumer Electronics Company PHL 346E2C UK02145033071" {
    // off

    focus-at-startup
    scale 1.0
    position x=1920 y=-400
    mode "3440x1440"
}

output "HDMI-A-1" {
    // off

    focus-at-startup
    scale 1.0
    position x=1920 y=0
    mode "1920x1080"
}
